# SALIN file ini -> ".env" lalu isi dengan kredensial ASLI kamu.

# ---- Login Google (Streamlit native OIDC) ----
REDIRECT_URI=http://localhost:8501/oauth2callback
COOKIE_SECRET=GANTI_DENGAN_STRING_RANDOM_PANJANG
GOOGLE_CLIENT_ID=GANTI_DENGAN_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GANTI_DENGAN_GOOGLE_CLIENT_SECRET
ALLOWED_EMAILS=

# ---- Database Supabase (Postgres langsung, connection pooler) ----
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD_KAMU@aws-0-xxxxx.pooler.supabase.com:6543/postgres

# ---- YouTube Data API v3 ----
YOUTUBE_API_KEY=GANTI_DENGAN_YOUTUBE_API_KEY

# ---- Model hasil training Colab ----
INDOBERTWEET_MODEL_PATH=models/indobertweet-sentiment-final
SBERT_MODEL_NAME=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
